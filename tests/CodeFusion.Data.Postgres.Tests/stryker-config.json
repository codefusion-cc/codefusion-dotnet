{
  "stryker-config": {
    "project": "CodeFusion.Data.Postgres.csproj",
    "test-runner": "mtp",
    "configuration": "Release",
    "concurrency": 2,
    "mutate": [ "**/PgConnection.cs", "**/PgRow.cs", "**/PgAuth.cs", "**/PgSettings.cs", "**/PgException.cs", "**/PgJob.cs" ],
    "reporters": [ "html", "json", "progress" ],
    "ignore-mutations": [ "string" ],
    "thresholds": { "high": 90, "low": 80, "break": 0 }
  }
}

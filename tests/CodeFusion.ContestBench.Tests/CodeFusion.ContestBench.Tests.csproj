<Project Sdk="Microsoft.NET.Sdk">

  <!-- The contest rig's own logic, with no VM: the $12 search loop, the cache and name checks, the ledger, the
       latency histogram, the monitor window, the CSV split and the README front lines. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>CodeFusion.ContestBench.Tests</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1515;CA1707;CA2007;CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="FsCheck.Xunit.v3" />
    <Compile Include="../Shared/RunGuard.cs" Link="Shared/RunGuard.cs" />
    <ProjectReference Include="../../benchmarks/CodeFusion.ContestBench/CodeFusion.ContestBench.csproj" />
  </ItemGroup>

</Project>

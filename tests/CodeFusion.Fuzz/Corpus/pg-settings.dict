# Connection strings: a URL or Npgsql key=value pairs
url="postgres://"
url2="postgresql://"
at="@"
colon=":"
slash="/"
q="?"
amp="&"
eq="="
semi=";"
host="Host="
port="Port="
user="Username="
userid="User Id="
db="Database="
pwd="Password="
sp="Search Path="
ssl="sslmode="
ssl2="SSL Mode="
require="require"
disable="disable"
ipv6="[::1]"
big="99999999999"
neg="-1"
pct="%"

<Project Sdk="Microsoft.NET.Sdk">

  <!-- The sample app's body binders are compiled here by the endpoint generator, as an app's would be. -->
  <Import Project="../../src/CodeFusion.Http/buildTransitive/CodeFusion.Http.props" />

  <!-- Coverage-guided fuzzing of the code that reads bytes from the network: the HTTP request parser (alone and
       against Kestrel's), the JSON body binder, and the Postgres client's message, startup and SCRAM parsing.
       The same targets run two ways (README.md):
       - dotnet test: Corpus/ is replayed and mutated a fixed number of times from a fixed seed, on every build;
       - CODEFUSION_FUZZ=<target> under libfuzzer-dotnet with the libraries instrumented by sharpfuzz (CI, nightly). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>CodeFusion.Fuzz</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
    <!-- Program.Main picks the fuzzing engine or the test runner. -->
    <XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
    <!-- Inline arrays read clearer in test data. The sample app (linked from CodeFusion.Http.Tests) binds bodies into
         public fields, and its per-connection service lives as long as its connection. -->
    <NoWarn>$(NoWarn);CA1861;CA1001;CA1051;CA1805</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Kestrel's HTTP/1.1 parser and message bodies, which the differential target runs over the same bytes. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="SharpFuzz" />
    <ProjectReference Include="../../src/CodeFusion.Http/CodeFusion.Http.csproj" />
    <ProjectReference Include="../../src/CodeFusion.Data.Postgres/CodeFusion.Data.Postgres.csproj" />
    <ProjectReference Include="../../src/CodeFusion.Http.Generators/CodeFusion.Http.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <Compile Include="../CodeFusion.Http.Tests/Sample/SampleApp.cs" Link="Json/SampleApp.cs" />
    <None Include="Corpus/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Only this project uses it; kept here rather than in Directory.Packages.props. -->
    <PackageVersion Include="SharpFuzz" Version="2.3.0" />
  </ItemGroup>

</Project>

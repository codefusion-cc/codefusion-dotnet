<Project Sdk="Microsoft.NET.Sdk">

  <!-- Writes bcrypt's lane loops into the library at compile time. Not shipped: the package holds only the result. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsPackable>false</IsPackable>
    <RootNamespace>CodeFusion.Security.Generators</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 4.14: in every SDK from 9.0.300, as bcrypt builds with. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="4.14.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>

</Project>

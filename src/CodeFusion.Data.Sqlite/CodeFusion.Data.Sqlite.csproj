<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CodeFusion.Data.Sqlite</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Public fields on counters are the API (read without copies); Int64, Int32 and Double are IDataCommand's names. -->
    <NoWarn>$(NoWarn);CA1051;CA1720</NoWarn>

    <PackageId>CodeFusion.Data.Sqlite</PackageId>
    <Description>A SQLite provider for CodeFusion.Data that allocates nothing per query: direct calls into SQLite, reads on the caller's thread on reader connections that keep their WAL snapshot until a write commits, and group commit on one writer thread.</Description>
    <PackageTags>sqlite;database;zero-allocation;performance</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CodeFusion.Data.Sqlite.Tests" />
    <InternalsVisibleTo Include="CodeFusion.Fuzz" />
    <ProjectReference Include="../CodeFusion.Data/CodeFusion.Data.csproj" />
    <!-- The native library only: e_sqlite3 for each RID. -->
    <PackageReference Include="SourceGear.sqlite3" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!-- The SQLite build tested: SourceGear.sqlite3's version is pinned exactly (Directory.Packages.props, and so in this
       package's dependencies), and the package file restored for it must be the one tested, by its SHA-512 (as NuGet
       records it beside the package). At open, the library loaded from it must also say it is that build
       (SqliteConn.TestedSourceId). -->
  <PropertyGroup>
    <SqliteNativeVersion>3.53.4</SqliteNativeVersion>
    <SqliteNativeSha512>W2mME6FU2IfIF3Agdr9loSiLTWRndIgFsLTim6pRxSV9WsrzkxV+ikjm32a2jiHGWW920qXT4R+cVHpgb2BTdA==</SqliteNativeSha512>
  </PropertyGroup>
  <Target Name="CheckSqliteNativePackage" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_SqliteNativePackage>$(NuGetPackageRoot)sourcegear.sqlite3/$(SqliteNativeVersion)/sourcegear.sqlite3.$(SqliteNativeVersion).nupkg</_SqliteNativePackage>
    </PropertyGroup>
    <Error Condition="!Exists('$(_SqliteNativePackage)')" Text="SourceGear.sqlite3 $(SqliteNativeVersion) isn't restored at $(_SqliteNativePackage)" />
    <GetFileHash Files="$(_SqliteNativePackage)" Algorithm="SHA512" HashEncoding="base64">
      <Output TaskParameter="Hash" PropertyName="_SqliteNativeHash" />
    </GetFileHash>
    <Error Condition="'$(_SqliteNativeHash)' != '$(SqliteNativeSha512)'"
           Text="SourceGear.sqlite3 $(SqliteNativeVersion) at $(_SqliteNativePackage) has SHA-512 $(_SqliteNativeHash), not the tested build's $(SqliteNativeSha512)" />
  </Target>

</Project>

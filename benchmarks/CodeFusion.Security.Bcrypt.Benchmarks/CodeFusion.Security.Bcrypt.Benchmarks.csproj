<Project Sdk="Microsoft.NET.Sdk">

  <!-- BenchmarkDotNet; the README says how to run it. -->
  <PropertyGroup>
    <!-- The repository sets one TargetFramework for its .NET 10 packages; cleared, so this one builds for each of its own. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>$(BcryptFrameworks)</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '11.0'))">$(TargetFrameworks);net11.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>CodeFusion.Security.Benchmarks</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1001;CA1515;CA1822;CA2007;CA2012</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- bcrypt's measurements were made with this one. -->
    <PackageReference Include="BenchmarkDotNet" VersionOverride="0.16.0-preview.2" />
    <PackageReference Include="BCrypt.Net-Next" />
    <ProjectReference Include="../../src/CodeFusion.Security.Bcrypt/CodeFusion.Security.Bcrypt.csproj" />
  </ItemGroup>

</Project>

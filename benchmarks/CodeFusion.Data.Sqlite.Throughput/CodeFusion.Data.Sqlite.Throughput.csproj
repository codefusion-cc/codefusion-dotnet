<Project Sdk="Microsoft.NET.Sdk">

  <!-- Throughput of CodeFusion.Data.Sqlite's two modes, readers of their own and Exclusive, under steady load: point
       reads, writers, and a read-mostly mix. A plain loop for a fixed time rather than BenchmarkDotNet, so it runs as
       one process pinned to one CPU, as a one-core server does. docs/benchmarks has its runs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>CodeFusion.Data.Sqlite.Throughput</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1515;CA5394</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/CodeFusion.Data.Sqlite/CodeFusion.Data.Sqlite.csproj" />
  </ItemGroup>

</Project>
